{
  "manifest_version": 2,
  "id": "github.zerlight.reply-integrity",
  "version": "1.2.1",
  "name": "Reply Integrity",
  "description": "保留 Planner 事实、隔离草稿文风，让回复器按聊天语气表达，并保留完整回复文本。",
  "author": {
    "name": "Reply Integrity",
    "url": "https://github.com/Zerlight/maibot-reply-integrity"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Zerlight/maibot-reply-integrity"
  },
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.3.19"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.20.0"
  },
  "dependencies": [],
  "capabilities": [],
  "plugin_type": "chat",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/logo.svg"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
